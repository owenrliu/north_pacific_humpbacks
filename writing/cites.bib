@article{stewart2023,
	title = {Boom-bust cycles in gray whales associated with dynamic and changing {Arctic} conditions},
	volume = {382},
	issn = {0036-8075, 1095-9203},
	url = {https://www.science.org/doi/10.1126/science.adi1847},
	doi = {10.1126/science.adi1847},
	abstract = {Climate change is affecting a wide range of global systems, with polar ecosystems experiencing the most rapid change. Although climate impacts affect lower-trophic-level and short-lived species most directly, it is less clear how long-lived and mobile species will respond to rapid polar warming because they may have the short-term ability to accommodate ecological disruptions while adapting to new conditions. We found that the population dynamics of an iconic and highly mobile polar-associated species are tightly coupled to Arctic prey availability and access to feeding areas. When low prey biomass coincided with high ice cover, gray whales experienced major mortality events, each reducing the population by 15 to 25\%. This suggests that even mobile, long-lived species are sensitive to dynamic and changing conditions as the Arctic warms.
          , 
            Editor’s summary
            
              Environments are responding to human-induced climate warming in a variety of ways, not all of them expected. Such changes can have large impacts on species and ecosystems. Responses to such changes may be most obvious in shorter-lived species, but Stewart
              et al
              . show that even some of the largest animals on the planet are susceptible to relatively minor changes (see the Perspective by Read). Specifically, they looked across a 50-year database on gray whale population estimates and found clear evidence of rapid population increases and declines in response to changing prey biomass and ice cover. —Sacha Vignieri
            
          , 
            Benthic prey biomass and ice-mediated access to feeding areas drive major population swings in eastern North Pacific gray whales.},
	language = {en},
	number = {6667},
	urldate = {2025-10-08},
	journal = {Science},
	author = {Stewart, Joshua D. and Joyce, Trevor W. and Durban, John W. and Calambokidis, John and Fauquier, Deborah and Fearnbach, Holly and Grebmeier, Jacqueline M. and Lynn, Morgan and Manizza, Manfredi and Perryman, Wayne L. and Tinker, M. Tim and Weller, David W.},
	month = oct,
	year = {2023},
	pages = {207--211},
	file = {PDF:C\:\\Users\\owenrliu\\Zotero\\storage\\7RNHX8XL\\Stewart et al. - 2023 - Boom-bust cycles in gray whales associated with dynamic and changing Arctic conditions.pdf:application/pdf;science.adi1847_sm:C\:\\Users\\owenrliu\\Zotero\\storage\\L2SHD57B\\science.adi1847_sm.pdf:application/pdf},
}

@article{hirzel_evaluating_2006,
	title = {Evaluating the ability of habitat suitability models to predict species presences},
	volume = {199},
	copyright = {https://www.elsevier.com/tdm/userlicense/1.0/},
	issn = {03043800},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0304380006002468},
	doi = {10.1016/j.ecolmodel.2006.05.017},
	abstract = {Models predicting species spatial distribution are increasingly applied to wildlife management issues, emphasising the need for reliable methods to evaluate the accuracy of their predictions. As many available datasets (e.g. museums, herbariums, atlas) do not provide reliable information about species absences, several presence-only based analyses have been developed. However, methods to evaluate the accuracy of their predictions are few and have never been validated. The aim of this paper is to compare existing and new presenceonly evaluators to usual presence/absence measures.},
